APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# The address a person types into their browser to reach this site.
#
# It matters more than it looks: the "confirm your email address" link is a
# signed URL built from this value, so if it says localhost and the resident is
# reading the email on their phone, the link points at their own machine and the
# confirmation can never complete. Set it to whatever you actually browse from,
# including the port, and match it to the machine you are browsing from:
#
#   http://localhost:8000              php artisan serve on the default port
#   http://localhost:8001              php artisan serve --port=8001
#   http://bdrpis.test                  a vhost or local domain
#
# In production this must be the public https address, or every emailed link
# will be a dead end.
APP_URL=http://localhost:8000

# How long a "confirm your email address" link stays valid, in minutes.
# 1440 is 24 hours - see the note in config/auth.php for why not the
# framework's default of 60.
AUTH_VERIFICATION_EXPIRE=1440

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bdrpis
# A dedicated account, not root. It needs CREATE/ALTER/DROP/INDEX so migrations
# and test resets work, but only on bdrpis and bdrpis_testing.
DB_USERNAME=bdrpis
# Never commit a real password. Copy this file to .env and fill it in locally.
DB_PASSWORD=

# To roll back to SQLite, comment out DB_HOST, DB_PORT, DB_DATABASE,
# DB_USERNAME and DB_PASSWORD, and set:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=C:/xamppp/htdocs/BDRPIS-Project/database/database.sqlite
# Both keys are needed: the sqlite connection reads DB_DATABASE as well.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail.
#
# Two deliveries depend on this working: the "confirm your email address" notice
# a resident gets on registering, and the emailed copy of a ready document.
# Both are sent synchronously, so there is no queue worker to run.
#
# The default writes the whole message into storage/logs/laravel.log and sends
# nothing. That is the right setting for development, and it is how the browser
# check finds its link: the verification URL is on its own line in the log.
#
# For real delivery, MAIL_MAILER=smtp and:
#
#   MAIL_USERNAME    the full Gmail address
#   MAIL_PASSWORD    a 16-character App Password, NOT the account password
#   MAIL_FROM_ADDRESS  the address that sends, which must be the same Gmail
#                      account or an alias it is allowed to send as
#
# Gmail will refuse the connection, or silently drop the mail, if MAIL_PASSWORD
# holds the real account password. An App Password is created at
# myaccount.google.com > Security > 2-Step Verification > App passwords, and it
# only appears once - Google shows it a single time and there is no way to read
# it back. Two-factor sign-in has to be on before the menu offers it.
#
# Never put a real address or password in this file. It is committed.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
